// Firebase Storage rules — deploy alongside database.rules.json.
// Public can read product images; only admins can upload/delete.
// 5 MB cap + image MIME whitelist keeps the free-tier 1 GB bucket safe.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.token.admin == true || (request.auth.token.email != null && request.auth.token.email.matches('.*@timber\\.com$')))
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if request.auth != null
        && (request.auth.token.admin == true || (request.auth.token.email != null && request.auth.token.email.matches('.*@timber\\.com$')));
    }
  }
}

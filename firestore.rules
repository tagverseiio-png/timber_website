// Firestore security rules — deploy alongside database.rules.json and storage.rules.
// Public can read active gallery entries; only admins can read hidden entries or write/delete.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@timber\\.com$'))
      );
    }

    match /gallery/{imageId} {
      allow read: if resource == null || resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}

